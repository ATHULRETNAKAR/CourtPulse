<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CourtPulse - Customer Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#8b5cf6',
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-gray-50 ">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <%- include("../../views/partials/admin/sidebar") %>

            <!-- Main Content -->
            <div class="flex-1 flex flex-col ">
                
                <!-- Header -->
                <%- include("../../views/partials/admin/header") %>

                    <!-- Main Content -->
                    <main class="flex-1 px-4 overflow-y-auto pt-4">
                        <div class="flex justify-between items-center mb-6">
                            <h1 class="text-2xl font-bold text-gray-800">My Orders</h1>
                            <div class="relative">
                                <input type="text" placeholder="Search orders"
                                    class="pl-10 pr-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                                <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400"
                                    fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="bg-white p-6 rounded-lg shadow-md min-h-full">

                            <div class="space-y-4">
                                <% if (orders && orders.length> 0) { %>
                                    <% orders.forEach(order=> { %>
                                        <% if (order.orderedItems && order.orderedItems.length> 0) { %>
                                            <% const firstItem=order.orderedItems[0]; %>
                                                <% const itemCount=order.orderedItems.length; %>
                                                    <a href="/admin/orderDetails/<%= order.orderId %>/<%= order.userId._id %>" class="block">
                                                        <div
                                                            class="bg-white rounded-lg border shadow-md p-4 flex items-center space-x-4 hover:bg-gray-50 cursor-pointer">
                                                            <img src="/productImg/<%= firstItem.product.variants[0].images[0] %>"
                                                                alt="<%= firstItem.product.productName %>"
                                                                class="w-16 h-16 object-contain rounded-md">

                                                            <div class="flex-1 flex-col">
                                                                <h2 class="text-l font-semibold text-purple-600">
                                                                    Order ID: <span class="text-purple-400">
                                                                        <%= order.orderId %>
                                                                    </span>
                                                                </h2>
                                                                <h2 class="text-l text-gray-600">
                                                                    User: <span class="text-gray-600 font-semibold">
                                                                        <%= order.userId.name %>
                                                                    </span>
                                                                </h2>
                                                                <h2 class="text-l text-gray-600">
                                                                    Order Date: <span class="text-gray-600 font-semibold">
                                                                        <%= order.formattedDate %>
                                                                    </span>
                                                                </h2>
                                                                <p class="text-sm text-gray-600 ">Items: <%= itemCount %>
                                                                        <%= itemCount> 1 ? 'products' : 'product' %></p>
                                                                <p class="text-lg font-bold text-red-700">₹ <%=
                                                                        order.finalAmount.toFixed(2) %>
                                                                </p>
                                                            </div>

                                                            <div class="text-right">
                                                                <div class="flex items-center space-x-2">
                                                                    <% const statusColors={ "Pending"
                                                                        : "bg-yellow-100 text-yellow-600" , "Processing"
                                                                        : "bg-blue-200 text-blue-700" , "Shipped"
                                                                        : "bg-indigo-200 text-indigo-700" , "Delivered"
                                                                        : "bg-green-100 text-green-600" , "Cancelled"
                                                                        : "bg-red-100 text-red-600" , "Return Request"
                                                                        : "bg-orange-200 text-orange-700" , "Returned"
                                                                        : "bg-gray-100 text-gray-600" }; const
                                                                        badgeClass=statusColors[order.status]
                                                                        || "bg-gray-100 text-gray-600" ; %>

                                                                        <span
                                                                            class="<%= badgeClass %> px-2 py-1 rounded flex items-center">
                                                                            <%= order.status %>
                                                                        </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </a>
                                                    <% } %>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <p class="text-center text-gray-600">No orders found.
                                                                </p>
                                                                <% } %>
                            </div>
                        </div>
                    </main>
            </div>
    </div>

</body>

</html>