<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CourtPulse - Customer Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#6366f1',
                        secondary: '#8b5cf6',
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-gray-50 ">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <%- include("../../views/partials/admin/sidebar") %>

            <!-- Main Content -->
            <div class="flex-1 flex flex-col ">

                <!-- Header -->
                <%- include("../../views/partials/admin/header") %>

                    <!-- Main Content -->
                    <main class="flex-1 px-4 overflow-y-auto pt-4">
                        <div class="flex justify-between items-center mb-6">
                            <h1 class="text-2xl font-bold text-gray-800">My Orders</h1>
                        </div>
                        <form method="GET" action="/admin/orders"
                            class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-6">
                            <div class="relative">
                                <input name="search" id="searchInput" type="text" placeholder="Search here"
                                    class="w-full sm:w-64 pl-10 pr-10 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                                    value="<%= search || '' %>">

                                <!-- Search icon -->
                                <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 cursor-pointer"
                                    id="searchBtn"></i>

                                <!-- Clear (X) button, hidden by default -->
                                <button id="clearSearch" type="button"
                                    class="hidden absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>

                            <select name="sort"
                                class="border border-gray-300 text-gray-700 px-4 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                                <option value="latest" <%=(sort==='latest' || !sort) ? 'selected' : '' %>>Latest
                                </option>
                                <option value="oldest" <%=sort==='oldest' ? 'selected' : '' %>>Oldest</option>
                                <option value="a-z" <%=sort==='a-z' ? 'selected' : '' %>>A-Z (User)</option>
                                <option value="z-a" <%=sort==='z-a' ? 'selected' : '' %>>Z-A (User)</option>
                            </select>

                            <select name="filter"
                                class="border border-gray-300 text-gray-700 px-4 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                                <option value="">All Status</option>
                                <% ['Pending', 'Processing' , 'Shipped' , 'Delivered' , 'Cancelled' , 'Return Request'
                                    , 'Returned', 'Rejected' ].forEach(status=> { %>
                                    <option value="<%= status %>" <%=filter===status ? 'selected' : '' %>><%= status %>
                                    </option>
                                    <% }); %>
                            </select>

                            <input type="hidden" name="page" value="1">

                            <button type="submit"
                                class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary/90 flex items-center justify-center space-x-2 transition-colors">
                                <i class="fas fa-search"></i>
                                <span>Apply</span>
                            </button>

                            <button type="button" id="clearAll"
                                class="border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 flex items-center justify-center space-x-2 transition-colors">
                                <i class="fas fa-times"></i>
                                <span>Clear</span>
                            </button>
                        </form>
                        <div class="bg-white p-6 rounded-lg shadow-md min-h-full">

                            <div class="space-y-4">
                                <% if (orders && orders.length> 0) { %>
                                    <% orders.forEach(order=> { %>
                                        <% if (order.orderedItems && order.orderedItems.length> 0) { %>
                                            <% const firstItem=order.orderedItems[0]; %>
                                                <% const itemCount=order.orderedItems.length; %>
                                                    <a href="/admin/orderDetails/<%= order.orderId %>/<%= order.userId._id %>"
                                                        class="block">
                                                        <div
                                                            class="bg-white rounded-lg border shadow-md p-4 flex items-center space-x-4 hover:bg-gray-50 cursor-pointer">
                                                            <img src="/productImg/<%= firstItem.product.variants[0].images[0] %>"
                                                                alt="<%= firstItem.product.productName %>"
                                                                class="w-16 h-16 object-contain rounded-md">

                                                            <div class="flex-1 flex-col">
                                                                <h2 class="text-l font-semibold text-purple-600">
                                                                    Order ID: <span class="text-purple-400">
                                                                        <%= order.orderId %>
                                                                    </span>
                                                                </h2>
                                                                <h2 class="text-l text-gray-600">
                                                                    User: <span class="text-gray-600 font-semibold">
                                                                        <%= order.userId.name %>
                                                                    </span>
                                                                </h2>
                                                                <h2 class="text-l text-gray-600">
                                                                    Order Date: <span
                                                                        class="text-gray-600 font-semibold">
                                                                        <%= order.formattedDate %>
                                                                    </span>
                                                                </h2>
                                                                <p class="text-sm text-gray-600 ">Items: <%= itemCount
                                                                        %>
                                                                        <%= itemCount> 1 ? 'products' : 'product' %></p>
                                                                <p class="text-lg font-bold text-red-700">₹ <%=
                                                                        order.finalAmount.toFixed(2) %>
                                                                </p>
                                                            </div>

                                                            <div class="text-right">
                                                                <div class="flex items-center space-x-2">
                                                                    <% const statusColors={ "Pending"
                                                                        : "bg-yellow-100 text-yellow-600" , "Processing"
                                                                        : "bg-blue-200 text-blue-700" , "Shipped"
                                                                        : "bg-indigo-200 text-indigo-700" , "Delivered"
                                                                        : "bg-green-100 text-green-600" , "Cancelled"
                                                                        : "bg-red-100 text-red-600" , "Return Request"
                                                                        : "bg-orange-200 text-orange-700" , "Returned"
                                                                        : "bg-gray-100 text-gray-600" }; const
                                                                        badgeClass=statusColors[order.status]
                                                                        || "bg-gray-100 text-gray-600" ; %>

                                                                        <span
                                                                            class="<%= badgeClass %> px-2 py-1 rounded flex items-center">
                                                                            <%= order.status %>
                                                                        </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </a>
                                                    <% } %>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <p class="text-center text-gray-600">No orders found.
                                                                </p>
                                                                <% } %>
                            </div>

                            <% if (totalPages && totalPages> 1) { %>
                                <div class="flex justify-center mt-6">
                                    <nav class="flex space-x-2">
                                        <% if (page> 1) { %>
                                            <a href="/admin/orders?page=<%= page - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= sort ? '&sort=' + sort : '' %><%= filter ? '&filter=' + filter : '' %>"
                                                class="px-3 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">Previous</a>
                                            <% } %>

                                                <% for(let i=Math.max(1, page - 2); i <=Math.min(totalPages, page + 2);
                                                    i++) { %>
                                                    <% if (i===1 || i===totalPages || (i>= page - 2 && i <= page + 2)) {
                                                            %>
                                                            <a href="/admin/orders?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= sort ? '&sort=' + sort : '' %><%= filter ? '&filter=' + filter : '' %>"
                                                                class="px-3 py-2 <%= i === page ? 'bg-primary text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %> rounded-lg transition-colors">
                                                                <%= i %>
                                                            </a>
                                                            <% } %>
                                                                <% } %>

                                                                    <% if (page < totalPages) { %>
                                                                        <a href="/admin/orders?page=<%= page + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= sort ? '&sort=' + sort : '' %><%= filter ? '&filter=' + filter : '' %>"
                                                                            class="px-3 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">Next</a>
                                                                        <% } %>
                                    </nav>
                                </div>
                                <% } %>
                        </div>
                    </main>
            </div>
    </div>
    <script>
        const form = document.querySelector('form');
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        const clearSearchBtn = document.getElementById('clearSearch');
        const clearAllBtn = document.getElementById('clearAll');

        // Search on icon click
        searchBtn.addEventListener('click', () => {
            form.submit();
        });

        // Show/hide clear search button
        if (searchInput.value) {
            clearSearchBtn.classList.remove('hidden');
        }
        searchInput.addEventListener('input', () => {
            if (searchInput.value) {
                clearSearchBtn.classList.remove('hidden');
            } else {
                clearSearchBtn.classList.add('hidden');
            }
        });

        // Clear search button
        clearSearchBtn.addEventListener('click', () => {
            searchInput.value = '';
            clearSearchBtn.classList.add('hidden');
            form.submit();
        });

        // Clear all
        clearAllBtn.addEventListener('click', () => {
            window.location.href = window.location.pathname;
        });

        // Auto-submit on sort/filter change (optional, for better UX)
        const sortSelect = form.querySelector('select[name="sort"]');
        const filterSelect = form.querySelector('select[name="filter"]');
        if (sortSelect) {
            sortSelect.addEventListener('change', () => {
                form.querySelector('input[name="page"]').value = '1';
                form.submit();
            });
        }
        if (filterSelect) {
            filterSelect.addEventListener('change', () => {
                form.querySelector('input[name="page"]').value = '1';
                form.submit();
            });
        }
    </script>
</body>

</html>