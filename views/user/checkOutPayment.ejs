<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CourtPulse</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">
    <!-- Header -->
    <%- include('../../views/partials/user/header') %>

        <div class="container mx-auto p-6 flex-1">
            <div class="flex flex-col md:flex-row gap-6">

                <!-- Payment Section (3/4 width) -->
                <div class="w-full md:w-3/4">
                    <div class="bg-white p-6 rounded-lg shadow-md h-full">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-2xl font-bold">Select Payment Method</h2>
                        </div>
                        <div>
                            <form id="paymentForm" class="space-y-4">
                                <label
                                    class="font-bold bg-gray-100 flex items-center space-x-2 p-3 border rounded-lg cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="razorpay" class="text-blue-600"
                                        checked>
                                    <span>Razorpay</span>
                                </label>
                                <label
                                    class="font-bold bg-gray-100 flex items-center space-x-2 p-3 border rounded-lg cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="wallet" class="text-blue-600">
                                    <span>Wallet</span>
                                </label>
                                <label
                                    class="font-bold bg-gray-100 flex items-center space-x-2 p-3 border rounded-lg cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="cod" class="text-blue-600">
                                    <span>Cash on Delivery (COD)</span>
                                </label>

                                <!-- <label
                                    class="font-bold bg-gray-100 flex items-center space-x-2 p-3 border rounded-lg cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="upi" class="text-blue-600">
                                    <span>UPI</span>
                                </label> -->

                            </form>
                        </div>
                    </div>
                </div>

                <!-- Order Summary (1/4 width) -->
                <div class="w-full md:w-1/4">
                    <div class="bg-white p-4 rounded shadow">
                        <!-- Order Summary -->
                        <h3 class="font-bold mb-2 pt-4">Order Summary</h3>
                        <div class="space-y-2 border-b pb-4">
                            <% if (cartItems && cartItems.length> 0) { %>
                                <% cartItems.forEach(item=> { %>
                                    <div class="flex justify-between">
                                        <span>
                                            <%= item.quantity %> x <%= item.product.name %>
                                        </span>
                                        <span>₹<%= item.totalPrice.toLocaleString() %></span>
                                    </div>
                                    <% }) %>
                                        <% } %>
                        </div>
                        <div>
                            <h3 class="font-bold mb-2 pt-4">Price Breakup</h3>
                            <div class="flex justify-between">
                                <span>Total Amount</span>
                                <span>₹<%= totalAmount.toLocaleString() %></span>
                            </div>
                            <div class="flex justify-between">
                                <span>Delivery Charges</span>
                                <span>₹<%= deliveryCharge.toLocaleString() %></span>
                            </div>
                            <div class="flex justify-between">
                                <span>Platform Fee</span>
                                <span>₹<%= platformFee.toLocaleString() %></span>
                            </div>
                            <div class="flex justify-between">
                                <span>Coupon Discount</span>
                                <span id="couponDiscount">₹0</span>
                            </div>
                            <div class="flex justify-between font-bold border-t pt-2 mt-4">
                                <span>Grand Total</span>
                                <span id="cartTotal">₹<%= ((totalAmount + deliveryCharge + platformFee) -
                                        0).toLocaleString() %></span>
                            </div>
                        </div>

                        <% if (cartItems && cartItems.length> 0) { %>
                            <button onclick="confirmOrder()"
                                class="w-full mt-4 px-4 py-2 bg-purple-600 text-white rounded">Continue</button>
                            <% } else { %>
                                <button
                                    class="w-full mt-4 px-4 py-2 bg-gray-400 text-white rounded cursor-not-allowed">Continue</button>
                                <% } %>
                    </div>
                </div>

            </div>
        </div>


        <!-- Footer -->
        <%- include('../../views/partials/user/subFooter') %>

            <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
            <script>
                async function confirmOrder() {
                    const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;

                    const data = {
                        paymentMethod: paymentMethod,
                        totalAmount: <%= totalAmount %>,
                        deliveryCharge: <%= deliveryCharge %>,
                            platformFee: <%= platformFee %>
                    };

                try {
                    if (paymentMethod === 'razorpay') {
                        const response = await fetch('/paymentOrderCreate', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const { success, order, key } = await response.json();
                        if (!success) throw new Error('Failed to create Razorpay Order');
                        const options = {
                            key,
                            amount: order.amount,
                            currency: 'INR',
                            name: 'CourtPulse',
                            description: 'Order Payment',
                            order_id: order.id,
                            handler: async function (response) {
                                const verifyRes = await fetch('/paymentVerify', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        ...response,
                                        orderData: data
                                    })
                                });
                                const verifyResult = await verifyRes.json();
                                if (verifyResult.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: '🎉 Payment Successful!',
                                        text: 'Your order has been placed successfully!',
                                        confirmButtonColor: '#6366f1'
                                    }).then(() => window.location.href = verifyResult.redirectUrl)
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Payment Verification Failed',
                                        text: verifyResult.message || 'Something went wrong!'
                                    });
                                }
                            },
                            modal: {
                                ondismiss: function () {
                                    Swal.fire({
                                        icon: 'info',
                                        title: 'Payment Cancelled',
                                        text: 'You cancelled the payment process'
                                    });
                                }
                            }
                        };
                        const rzp = new Razorpay(options);

                        rzp.on('payment.failed', async function (response) {
                            await fetch('/paymentFailure', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    order_id: order.id,
                                    reason: response.error.reason,
                                    code: response.error.code,
                                    description: response.error.description,
                                    orderData: data
                                })
                            })
                                .then(res => res.json())
                                .then(result => {
                                    if (result.success && result.redirectUrl) {
                                        window.location.href = result.redirectUrl;
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Payment Failed',
                                            text: 'Please try again'
                                        })
                                    }
                                })
                        });
                        rzp.open();
                    } else if (paymentMethod === 'wallet') {
                        try {
                            const response = await fetch('/walletPayment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(data)
                            });
                            const result = await response.json();
                            if (result.success) {
                                Swal.fire({
                                    title: '<h2 class="text-2xl font-bold text-green-600">Wallet Payment Successful 🎉</h2>',
                                    html: `<p class="text-gray-700">₹${result.amount} has been deducted from your wallet balance.</p>`,
                                    icon: 'success',
                                    confirmButtonText: 'Go to My Orders',
                                    confirmButtonColor: '#16a34a',
                                    background: '#f9fafb'
                                }).then(() => {
                                    window.location.href = result.redirectUrl;
                                });
                            } else {
                                Swal.fire({
                                    title: '<h2 class="text-2xl font-bold text-red-600">Wallet Payment Failed ❌</h2>',
                                    html: `<p class="text-gray-700">${result.message}</p>`,
                                    icon: 'error',
                                    confirmButtonText: 'Go Back to Checkout',
                                    confirmButtonColor: '#dc2626'
                                }).then(() => {
                                    window.location.href = '/checkOutPayment';
                                });
                            }
                        } catch (error) {
                            console.error('Wallet payment error:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Something went wrong',
                                text: 'Please try again later.'
                            });
                        }
                    } else {
                        const response = await fetch('/confirmOrder', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await response.json();
                        if (result.success) {
                            Swal.fire({
                                title: '<h2 class="text-2xl font-bold text-green-600">🎉 Order Placed Successfully!</h2>',
                                html: '<p class="text-gray-700">Thank you for shopping with us.<br>Your order has been placed and will be processed shortly.</p>',
                                icon: 'success',
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#16a34a',
                                background: '#f9fafb',
                                backdrop: ` rgba(5,0,0,0.4) url("/images/order-placed.gif")  center top no-repeat `
                            })
                                .then(() => {
                                    window.location.href = result.redirectUrl
                                })
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Failed',
                                text: result.message
                            });
                        }
                    }
                } catch (error) {
                    console.log("Error from checkOut Payment : ", error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong. Please try again.'
                    })
                }
            }
            </script>
</body>

</html>