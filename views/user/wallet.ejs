<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wallet - CourtPulse</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'court-purple': '#A855F7',
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-gray-50">
    <!-- Header -->
    <%- include('../../views/partials/user/header') %>

        <div class="flex min-h-screen bg-gray-50">
            <!-- Sidebar -->
            <%- include("../../views/partials/user/profileSideBar") %>

                <!-- Main Content -->
                <div class="flex-1 p-6">
                    <div class="bg-white rounded-lg shadow p-6">
                        <h1 class="text-2xl font-bold text-gray-900 mb-6">My Wallet</h1>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">

                            <div class="bg-gray-50 p-4 rounded-lg">
                                <p class="text-sm font-medium text-gray-600">Wallet Balance</p>
                                <p class="text-2xl font-bold text-gray-900">₹ <%= walletBalance.toFixed(2) %>
                                </p>
                            </div>

                        </div>

                        <!-- Add Money Section -->
                        <div id="addMoneySection" class="bg-white p-6 rounded-lg shadow border">
                            <h2 class="text-lg font-semibold text-gray-900 mb-4">Add money to wallet</h2>
                            <div class="flex flex-col sm:flex-row gap-4 items-end">
                                <div class="flex-1">
                                    <label for="amount" class="block text-sm font-medium text-gray-700 mb-1">Amount (
                                        upto - 10000 )</label>
                                    <div class="relative">
                                        <div
                                            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <span class="text-gray-500 text-sm">₹</span>
                                        </div>
                                        <input type="number" id="amount" value="2000"
                                            class="block w-full pl-8 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-court-purple focus:border-court-purple"
                                            placeholder="0">
                                    </div>
                                </div>
                                <div class="flex space-x-2 ">
                                    <button id="addMoneyBtn"
                                        class="bg-court-purple hover:bg-court-purple/90 text-white px-6 py-2 rounded-md text-sm font-medium transition-colors">Add
                                        money to wallet</button>
                                    <button id="historyBtn"
                                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-2 rounded-md text-sm font-medium transition-colors">History</button>
                                </div>
                            </div>
                        </div>

                        <!-- History Section (Initially Hidden) -->
                        <div id="historySection" class="hidden bg-white p-6 rounded-lg shadow border mt-4">
                            <div class="flex justify-between items-center mb-4">
                                <h2 class="text-lg font-semibold text-gray-900">Transaction History</h2>
                                <button id="backToAddBtn"
                                    class="text-court-purple hover:text-court-purple/80 text-sm font-medium">← Back to
                                    Add Money</button>
                            </div>
                            <!-- Scrollable History Table -->
                            <div id="historyTable" class="overflow-x-auto">
                                <div class="overflow-y-auto max-h-96 border rounded-lg">
                                    <table class="min-w-full divide-y divide-gray-200">
                                        <thead class="bg-gray-50 sticky top-0">
                                            <tr>
                                                <th
                                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Date</th>
                                                <th
                                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Type</th>
                                                <th
                                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Amount</th>
                                                <th
                                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Status</th>
                                                <th
                                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Transaction Id</th>
                                            </tr>
                                        </thead>
                                        <tbody id="historyBody" class="bg-white divide-y divide-gray-200">
                                            <!-- History rows will be inserted here -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div id="historyLoading" class="hidden flex justify-center py-8">
                                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-court-purple"></div>
                            </div>
                            <div id="noHistory" class="hidden text-center py-8 text-gray-500">
                                <p>No transactions found.</p>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <!-- Footer -->
        <%- include('../../views/partials/user/subFooter') %>

            <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
            <script>
                // Add Money Script
                document.getElementById('addMoneyBtn').addEventListener('click', async () => {
                    const amount = document.getElementById('amount').value;
                    if (!amount || amount <= 0 || amount >= 10001) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Invalid',
                            text: 'Please enter a valid amount '
                        })
                        return;
                    }

                    try {
                        const response = await fetch('/walletAddMoney', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ amount: parseFloat(amount) })
                        });

                        if (!response.ok) {
                            throw new Error('Failed to add money');
                        }

                        const { success, data, key } = await response.json();
                        console.log(data)
                        if (!success) {
                            throw new Error(data.message || 'Failed to create order')
                        }
                        const option = {
                            key,
                            amount: data.amount * 100,
                            currency: data.currency,
                            name: "CourtPulse Wallet",
                            description: "Add Money to Wallet",
                            order_id: data.id,
                            handler: async function (response) {
                                const verifyRes = await fetch('/walletVerifyPayment', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        razorpay_order_id: response.razorpay_order_id,
                                        razorpay_payment_id: response.razorpay_payment_id,
                                        razorpay_signature: response.razorpay_signature,
                                        amount: parseFloat(amount)
                                    })
                                });
                                const verifyData = await verifyRes.json();
                                if (verifyData.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Payment Successful',
                                        text: 'Money added to your wallet successfully'
                                    }).then(() => location.reload())
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Payment Failed',
                                        text: verifyData.message || 'Verification Failed',
                                    })
                                }
                            },
                            theme: { color: "#A855F7" }
                        };
                        const rzp = new Razorpay(option);
                        rzp.on('payment.failed', async function (response) {
                            await fetch('/walletPaymentFailure', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    orderId: response.error.metadata.order_id,
                                    paymentId: response.error.metadata.payment_id,
                                    reason: response.error.reason,
                                    description: response.error.description,
                                    amount: parseFloat(amount)
                                })
                            })
                                .then(res => res.json())
                                .then(result => {
                                    if (result.success && result.redirectUrl) {
                                        window.location.href = result.redirectUrl;
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Payment Failed',
                                            text: 'Please try again'
                                        })
                                    }
                                })
                        })
                        rzp.open();
                    } catch (error) {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed',
                            text: 'Payment failed, Please try again.'
                        })
                    }
                });

                // History Script
                const addMoneySection = document.getElementById('addMoneySection');
                const historySection = document.getElementById('historySection');
                const historyBtn = document.getElementById('historyBtn');
                const backToAddBtn = document.getElementById('backToAddBtn');
                const historyBody = document.getElementById('historyBody');
                const historyLoading = document.getElementById('historyLoading');
                const noHistory = document.getElementById('noHistory');

                historyBtn.addEventListener('click', async () => {
                    addMoneySection.classList.add('hidden');
                    historySection.classList.remove('hidden');
                    await loadHistory();
                });

                backToAddBtn.addEventListener('click', () => {
                    historySection.classList.add('hidden');
                    addMoneySection.classList.remove('hidden');
                });

                async function loadHistory() {
                    historyLoading.classList.remove('hidden');
                    historyBody.innerHTML = '';
                    noHistory.classList.add('hidden');

                    try {
                        const response = await fetch('/walletHistory', {
                            method: 'GET',
                            headers: { 'Content-Type': 'application/json' }
                        });

                        if (!response.ok) {
                            throw new Error('Failed to load history');
                        }

                        const transactions = await response.json();

                        if (transactions.length === 0) {
                            noHistory.classList.remove('hidden');
                            historyLoading.classList.add('hidden');
                            return;
                        }

                        transactions.forEach(transaction => {
                            const row = document.createElement('tr');
                            row.className = 'hover:bg-gray-50';
                            row.innerHTML = `
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${new Date(transaction.date).toLocaleDateString()}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${transaction.type}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm ${transaction.type === 'credit' ? 'text-green-600' : 'text-red-600'} font-medium">₹${transaction.amount.toFixed(2)}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${transaction.status === 'Completed' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
                                ${transaction.status}
                                </span>
                                </td>
                         <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${transaction.transactionId}</td>
                    `;
                            historyBody.appendChild(row);
                        });

                        historyLoading.classList.add('hidden');
                    } catch (error) {
                        console.error('Error:', error);
                        alert('Error loading history. Please try again.');
                        historyLoading.classList.add('hidden');
                        noHistory.classList.remove('hidden');
                    }
                }
            </script>
</body>

</html>