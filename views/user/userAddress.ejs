<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Addresses - CourtPulse</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-100 font-sans min-h-screen flex flex-col">
    <!-- Header -->
    <%- include("../../views/partials/user/header") %>

        <!-- Page Content (must take available height) -->
        <div class="flex flex-1 mt-4">
            <!-- Sidebar -->
            <%- include("../../views/partials/user/profileSideBar") %>

                <!-- Main Content -->
                <div class="flex-1 p-6">
                    <div class="bg-white p-6 rounded-lg shadow-md h-full">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-2xl font-bold">Manage Addresses</h2>
                            <a href="/addAddress"
                                class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">
                                Add New Address
                            </a>
                        </div>
                        <div class="space-y-4">
                            <% if (addresses && addresses.length> 0) { %>
                                <% addresses.forEach(address=> { %>
                                    <div id="address-<%= address._id %>"
                                        class="border p-4 rounded-lg flex justify-between items-center">
                                        <div>
                                            <p class="font-semibold">
                                                <%= address.name %>,
                                                    <span class="text-gray-600"><%= address.mobile %></span>
                                                    <span class="font-bold text-blue-500"><%= address.addressType.toUpperCase() %></span>  
                                            </p>
                                            <p>
                                                <%= address.address %>, <%= address.locality %>, <%= address.city %>,
                                                            <%= address.state %> - <%= address.pincode %>
                                                                    <% if (address.landmark) { %>
                                                                        (Landmark: <%= address.landmark %>)
                                                                            <% } %>
                                                                                <% if (address.altPhone) { %>
                                                                                    , Alternate Phone: <%=
                                                                                        address.altPhone %>
                                                                                        <% } %>
                                            </p>
                                        </div>
                                        <div class="flex space-x-2">
                                            <a href="/editAddress/<%= address._id %>"
                                                class="text-blue-500 hover:text-blue-700">Edit</a>
                                            <button onclick="deleteAddress('<%= address._id %>')"
                                                class="text-red-500 hover:text-red-700">Delete</button>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <p class="text-gray-500">No addresses found. Add a new address to get
                                                started.</p>
                                            <% } %>
                        </div>
                    </div>
                </div>
        </div>

        <!-- Footer -->
        <%- include("../../views/partials/user/subFooter") %>

            <script>
                function deleteAddress(addressId) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Delete Address',
                        text: 'Are you sure you want to delete this address?',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, delete it',
                        cancelButtonText: 'Cancel',
                    }).then((result) => {
                        if (result.isConfirmed) {
                            fetch(`/deleteAddress/${addressId}`, {
                                method: 'DELETE',
                            })
                                .then(res => res.json())
                                .then(data => {
                                    if (res.ok) {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'Deleted',
                                            text: data.message,
                                        });
                                        // Remove the address from the DOM
                                        document.getElementById(`address-${addressId}`).remove();
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Error',
                                            text: data.message || 'Failed to delete address',
                                        });
                                    }
                                })
                                .catch(err => {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: 'Something went wrong',
                                    });
                                });
                        }
                    });
                }
            </script>
</body>

</html>