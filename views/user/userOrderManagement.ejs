<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders - CourtPulse</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">
    <!-- Header -->
    <%- include("../../views/partials/user/header") %>

    <div class="flex flex-1">
        <!-- Sidebar -->
        <%- include("../../views/partials/user/profileSideBar") %>

        <!-- Main Content -->
        <main class="flex-1 p-6 md:p-8">
            <div class="max-w-4xl mx-auto">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-2xl font-bold text-gray-800">My Orders</h1>
                    <div class="relative">
                        <input type="text" placeholder="Search orders" class="pl-10 pr-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </div>

                <div class="space-y-4">
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                            <div class="bg-white rounded-lg shadow-md p-4 flex items-center space-x-4">
                                <img src="<%= order.image %>" alt="<%= order.productName %>" class="w-16 h-16 object-contain rounded-md">
                                <div class="flex-1">
                                    <h2 class="text-lg font-semibold text-gray-800"><%= order.productName %></h2>
                                    <p class="text-sm text-gray-600">orderId - <%= order.orderId %></p>
                                    <p class="text-lg font-bold text-gray-900">₹ <%= order.price %></p>
                                </div>
                                <div class="text-right">
                                    <div class="flex items-center space-x-2">
                                        <span class="w-3 h-3 rounded-full <%= order.statusColor %>"></span>
                                        <p class="text-sm font-medium <%= order.statusTextColor %>"><%= order.status %></p>
                                    </div>
                                    <!-- <p class="text-sm text-gray-600"><%= order.description %></p> -->
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-center text-gray-600">No orders found.</p>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <!-- Sub-Footer -->
    <%- include("../../views/partials/user/subFooter") %>
</body>

</html>